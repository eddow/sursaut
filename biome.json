{
	"$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
	"files": {
		"includes": [
			"packages/**/src/**/*.ts",
			"packages/**/src/**/*.tsx",
			"packages/**/demo/**/*.ts",
			"packages/**/demo/**/*.tsx",
			"sandbox/**/*.ts",
			"!**/dist",
			"!**/node_modules",
			"!**/.turbo"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.spec.tsx", "**/*.spec.ts"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": true
			}
		}
	],
	"javascript": {
		"formatter": {
			"lineWidth": 100,
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "es5",
			"indentStyle": "tab"
		}
	},
	"linter": {
		"rules": {
			"style": {
				"noNonNullAssertion": "off",
				"useSingleVarDeclarator": {
					"level": "warn",
					"fix": "safe"
				},
				"useTemplate": {
					"level": "warn",
					"fix": "safe"
				},
				"noParameterAssign": "off",
				"useImportType": { "level": "warn", "fix": "safe" },
				"useConst": {
					"level": "info",
					"fix": "none"
				}
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noDebugger": "warn",
				"noConsole": "off",
				"noConfusingVoidType": "off",
				"noAssignInExpressions": "off",
				"noImplicitAnyLet": "off",
				"useIterableCallbackReturn": "off",
				"noRedeclare": "off",
				"noShadowRestrictedNames": "off",
				"noGlobalIsNan": { "level": "warn", "fix": "safe" }
			},
			"performance": {
				"noAccumulatingSpread": "off"
			},
			"complexity": {
				"noUselessFragments": "off",
				"noBannedTypes": "off",
				"useOptionalChain": { "level": "warn", "fix": "safe" }
			},
			"security": {},
			"correctness": {
				"noUnusedImports": {
					"level": "info",
					"fix": "safe"
				},
				"noUnusedFunctionParameters": {
					"level": "info",
					"fix": "safe"
				},
				"noUnusedLabels": "off"
			},
			"nursery": {},
			"a11y": {
				"useButtonType": "off",
				"noStaticElementInteractions": "off",
				"useValidAnchor": "off",
				"useSemanticElements": "off",
				"useKeyWithClickEvents": "off",
				"useAriaPropsSupportedByRole": "off",
				"noLabelWithoutControl": "off",
				"noNoninteractiveElementToInteractiveRole": "off",
				"noRedundantRoles": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
