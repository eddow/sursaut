{
  "name": "@sursaut/core",
  "version": "0.1.0",
  "description": "Fine-grained reactive UI framework with direct DOM manipulation",
  "types": "./dist/dom.d.ts",
  "scripts": {
    "dev": "vite --port 5290",
    "demo": "vite --port 5290",
    "build": "vite build",
    "build:all": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "NODE_OPTIONS='--expose-gc' vitest run",
    "test:e2e": "playwright test --forbid-only",
    "test:ui": "playwright test --ui",
    "prepack": "rm -rf dist/demo dist/src/entry.d.ts && find dist -name '*.spec.d.ts' -delete"
  },
  "keywords": [
    "sursaut",
    "reactive",
    "jsx",
    "ui",
    "framework",
    "fine-grained"
  ],
  "author": "fmdm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddow/sursaut.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/dom.js",
    "./dist/dom.cjs",
    "./dist/node.js",
    "./dist/node.cjs",
    "./src/dom/index.ts",
    "./src/node/index.ts",
    "./src/lib/node.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/dom.d.ts",
      "node": "./dist/node.js",
      "import": "./dist/dom.js",
      "default": "./dist/dom.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "default": "./dist/dom.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@playwright/test": "^1.58.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-legacy": "^7.2.1",
    "baseline-browser-mapping": "^2.9.11",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "jsdom": "^27.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "dependencies": {
    "mutts": "^1.0.13",
    "@babel/core": "^7.28.4",
    "@babel/plugin-proposal-decorators": "^7.28.6",
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@babel/types": "^7.28.6"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LLM.md"
  ],
  "packageManager": "pnpm@10.30.0"
}